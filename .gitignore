# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/

# Project artifacts (large; not for git). Anchored to repo root so that
# `src/apple_bench/data/` (the package) and similar paths aren't swept up.
/data/
/runs/
*.pt
*.pth
*.onnx
*.engine
*.tflite

# User-supplied datasets and source PDFs (not part of the codebase)
Apple leaf dataset/
*.pdf

# Derived paper artifacts — regenerated by scripts/08_make_figures.py and
# scripts/09_make_results_table.py from the canonical CSVs. The directory
# structure (.gitkeep files + README.md) is tracked; the renders are not.
/paper/figures/*
!/paper/figures/.gitkeep
/paper/tables/*
!/paper/tables/.gitkeep

# OS
.DS_Store
Thumbs.db
